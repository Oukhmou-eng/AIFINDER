# Validation API provider:
# local  = validation interne seulement
# google = Google AI Studio / Gemini API
# openai = OpenAI Responses API
# custom = ton endpoint HTTP
AIFINDER_VALIDATION_PROVIDER=google

# Google AI Studio / Gemini API key
# IMPORTANT : remplace cette valeur par une NOUVELLE cle depuis https://aistudio.google.com/app/apikey
# (l'ancienne cle a ete exposee, elle doit etre regeneree)
GEMINI_API_KEY=AQ.Ab8RN6KwQMBBx88iuBYmrKgXwUCZqUnRfXNoZngg8OXiNargQQ 
AIFINDER_GOOGLE_MODEL=gemini-2.5-flash-lite

# Si true, une erreur API externe bloque la validation.
# Si false, le backend utilise la validation locale en fallback.
AIFINDER_VALIDATION_REQUIRE_EXTERNAL=false
AIFINDER_VALIDATION_TIMEOUT=20

# Custom API, seulement si AIFINDER_VALIDATION_PROVIDER=custom
AIFINDER_VALIDATION_ENDPOINT=
AIFINDER_VALIDATION_API_KEY=

# OpenAI, seulement si AIFINDER_VALIDATION_PROVIDER=openai
OPENAI_API_KEY=
AIFINDER_OPENAI_MODEL=gpt-4.1-mini
